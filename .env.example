# ---------------------------------------------------------------------------
# MalakandBazaar — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# NEVER put a real secret in this file.
#
#   cp .env.example .env.local
#
# Where to find each value: Supabase dashboard → your project → Settings.
# ---------------------------------------------------------------------------


# === Site =================================================================
# No trailing slash. Used for absolute URLs (sitemap, OG images, CSP,
# CSRF Origin check, password-reset links later).
NEXT_PUBLIC_SITE_URL=http://localhost:3200


# === Supabase =============================================================
# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Settings → API → Project API keys → service_role  (secret)
# SERVER ONLY. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_,
# never import into a Client Component, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Settings → API → Project API keys → anon / publishable
# Not used by the app (the browser never talks to Supabase directly).
# Kept so Storage public read URLs and the CLI work without surprises.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → Database → Connection string → URI, "Transaction pooler" (port 6543).
# Pooler, not the direct 5432 string — serverless opens many short connections
# and would exhaust the direct pool. `?pgbouncer=true` disables prepared
# statements, which transaction mode cannot support.
# Password is the DB password you set when creating the project; URL-encode
# any of @ : / ? # [ ] in it.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Same credentials on port 5432, SESSION mode. Migrations and any DDL run here —
# the transaction pooler cannot run them.
# Use the POOLER host, not db.YOUR-PROJECT-REF.supabase.co: that legacy direct
# host is IPv6-only on projects created since 2024 and will not resolve from an
# IPv4 network or from most CI runners.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Supabase Storage bucket that holds listing photos, seller avatars and banners.
# Created by migration; change only if you rename it.
SUPABASE_STORAGE_BUCKET=media


# === Auth ================================================================
# HS256 signing secret for the 15-minute access token. 32+ random bytes.
# Generate:  openssl rand -base64 48
AUTH_JWT_SECRET=

# Rotation support: set the previous secret here for one deploy after changing
# AUTH_JWT_SECRET, so tokens signed with the old key still verify. Then clear it.
AUTH_JWT_SECRET_PREVIOUS=

# JWT iss / aud claims. Any stable strings; they just have to match.
AUTH_JWT_ISSUER=malakandbazaar
AUTH_JWT_AUDIENCE=malakandbazaar-web

# Pepper mixed into the refresh-token hash and the daily IP-hash salt.
# Changing it invalidates every refresh token (all users re-login).
# Generate:  openssl rand -base64 32
AUTH_TOKEN_PEPPER=

# Lifetimes. Defaults are the ones the plan specifies; override only
# deliberately — a longer access token slows down role and ban propagation.
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d


# === Cloudflare Turnstile (bot gate on signup + seller registration) ======
# dash.cloudflare.com → Turnstile → Add site.
# For local work use Cloudflare's always-pass test pair:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# === Cron / internal ======================================================
# Bearer token guarding /api/internal/* (the rank-score refresh fallback when
# pg_cron is unavailable). Must match the Authorization header your scheduler
# sends.  Generate:  openssl rand -hex 32
CRON_SECRET=


# === Operations (optional) ===============================================
# Public WhatsApp/phone shown in the header, footer and floating button.
# E.164, no spaces.
NEXT_PUBLIC_SUPPORT_PHONE=+92XXXXXXXXXX

# error | warn | info | debug
LOG_LEVEL=info

# Set true ONLY in a throwaway environment. Enables /api/dev/* seeding
# helpers. Never true in production.
ENABLE_DEV_ENDPOINTS=false
